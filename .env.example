# Optional. Without a key, ForkTheFuture runs a deterministic offline extractor (no AI) and labels it as such.
# Get a free-tier key at https://aistudio.google.com/apikey
# WARNING: free-tier Gemini requests may be used to improve Google products. Don't upload confidential manuscripts.
GEMINI_API_KEY=

# Must be one of the allowlisted free-tier models: gemini-2.5-flash-lite, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# Hard caps for the server-side Gemini call.
GEMINI_MAX_INPUT_CHARS=60000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_DAILY_CALL_CAP=200
